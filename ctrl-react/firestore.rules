rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function ownsDocument() {
      return isAuthenticated()
        && resource.data.userId is string
        && resource.data.userId == request.auth.uid;
    }

    function createsOwnedDocument() {
      return isAuthenticated()
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow create: if createsOwnedDocument();
      allow read, delete: if ownsDocument();
      allow update: if ownsDocument()
        && request.resource.data.userId == resource.data.userId;
    }

    match /task_completion_archive/{archiveId} {
      allow create, update: if isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
          'userId',
          'taskId',
          'completedAt',
          'priority'
        ])
        && request.resource.data.taskId is string
        && request.resource.data.completedAt is string
        && request.resource.data.priority is string;
      allow read, delete: if ownsDocument();
    }

    match /habits/{habitId} {
      allow create: if createsOwnedDocument();
      allow read, delete: if ownsDocument();
      allow update: if ownsDocument()
        && request.resource.data.userId == resource.data.userId;
    }

    match /pomodoro_sessions/{sessionId} {
      allow create: if createsOwnedDocument()
        && request.resource.data.durationMinutes is number
        && request.resource.data.durationMinutes > 0;
      allow read, delete: if ownsDocument();
      allow update: if false;
    }

    match /habit_logs/{habitLogId} {
      allow create: if createsOwnedDocument();
      allow read, delete: if ownsDocument();
      allow update: if ownsDocument()
        && request.resource.data.userId == resource.data.userId;
    }

    match /routines/{routineId} {
      allow create: if createsOwnedDocument();
      allow read, delete: if ownsDocument();
      allow update: if ownsDocument()
        && request.resource.data.userId == resource.data.userId;
    }

    match /messages/{messageId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'message',
          'userId',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }
  }
}
